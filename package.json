{
  "name": "cipher",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --parallel start",
    "lint": "pnpm --recursive lint",
    "clean": "pnpm --recursive clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "vitest run --project apps/web",
    "test:ui-web": "vitest run --project ui-web",
    "test:shared": "vitest run --project shared",
    "test:api": "vitest run --project api",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@t3-oss/env-core": "^0.13.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
