{
  "name": "cipher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --parallel start",
    "lint": "oxlint --config ./oxlint.config.ts apps packages",
    "lint:fix": "oxlint --config ./oxlint.config.ts --fix apps packages",
    "clean": "rimraf --glob **/node_modules **/.next **/dist **/build **/coverage playwright-report **/.cache **/.turbo",
    "clean:cache": "rimraf --glob **/.next **/.cache **/.turbo",
    "fresh": "pnpm clean && pnpm install",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:web": "vitest run --project apps/web",
    "test:unit:ui-web": "vitest run --project ui-web",
    "test:unit:shared": "vitest run --project shared",
    "test:unit:api": "vitest run --project api",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@fullstacksjs/oxlint-config": "1.1.0",
    "@playwright/test": "^1.62.1",
    "@t3-oss/env-core": "^0.13.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "oxlint": "1.85.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
