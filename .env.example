DATABASE_URL="url"
SESSION_SECRET="secret"
NODE_ENV="development"
BACKEND_PORT="port"
NEXT_PUBLIC_API_URL="url"
CLIENT_ORIGIN="url"
PLAYWRIGHT_BASE_URL="url"


# API server only. Register a GitHub OAuth App with this exact callback URL.
# Default off, even when credentials exist. Set true and restart the API to enable.
# Never use NEXT_PUBLIC_ for this flag or the OAuth credentials.
GITHUB_AUTH_ENABLED="false"
# GITHUB_CLIENT_ID="your-oauth-app-client-id"
# GITHUB_CLIENT_SECRET="set-in-deployment-secret-store"
# GITHUB_REDIRECT_URI="http://localhost:3001/auth/github/callback"
